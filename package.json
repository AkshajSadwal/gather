{
  "name": "instagram-clone",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "scripts": {
    "dev:backend": "npm run dev --workspace=@instagram-clone/backend",
    "dev:frontend": "npm run dev --workspace=@instagram-clone/frontend",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:status": "prisma migrate status",
    "db:seed": "prisma db seed",
    "test": "npm run test --workspace=@instagram-clone/backend",
    "test:e2e": "playwright test",
    "build": "npm run build --workspace=@instagram-clone/frontend",
    "lint": "npm run lint --workspaces --if-present",
    "storage:check": "node -e \"require('./backend/src/services/minio').check().then(ok=>{console.log(ok?'MinIO storage: connected':'MinIO storage: unavailable');process.exit(ok?0:1)})\""
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "prisma": "^6.16.2"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "mediasoup@3.28.0": true,
    "prisma@6.19.3": true,
    "unrs-resolver": false
  }
}
