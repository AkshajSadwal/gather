{
  "name": "instagram-clone",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @instagram-clone/backend --filter @instagram-clone/frontend dev",
    "dev:backend": "pnpm --filter @instagram-clone/backend dev",
    "dev:frontend": "pnpm --filter @instagram-clone/frontend dev",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:status": "prisma migrate status",
    "db:seed": "prisma db seed",
    "test": "pnpm --filter @instagram-clone/backend test",
    "build": "pnpm --filter @instagram-clone/frontend build",
    "lint": "pnpm --filter @instagram-clone/frontend lint"
  },
  "devDependencies": {
    "prisma": "^6.16.2"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2"
  },
  "prisma": { "seed": "node prisma/seed.js" }
}
