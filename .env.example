# Copy this file to .env and replace the local development secrets.
DATABASE_URL=postgresql://social:social_dev_password@localhost:5432/instagram_clone?schema=public
AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_LOGIN=false
BACKEND_PORT=4000
BACKEND_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
INTERNAL_AUTH_SECRET=replace-with-a-different-random-secret
NEXT_PUBLIC_STUN_URL=stun:stun.l.google.com:19302
UPLOAD_DIR=uploads
CLEANUP_INTERVAL_MS=1800000
ADMIN_USERNAMES=
NODE_ENV=development

# Object storage (MinIO locally; S3-compatible in production). Keep the bucket private.
MINIO_ENABLED=true
MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=gatheradmin
MINIO_SECRET_KEY=gather_dev_storage_password
MINIO_BUCKET=gather-media
MINIO_REGION=us-east-1
MINIO_PRESIGN_EXPIRES_SECONDS=300
MINIO_STARTUP_RETRIES=15
MINIO_STARTUP_RETRY_DELAY_MS=1000

# mediasoup SFU. The default listen IP is for same-host development only.
MEDIASOUP_WORKER_COUNT=1
MEDIASOUP_LISTEN_IP=127.0.0.1
# Set an externally reachable IPv4/IPv6 address in production; leave blank for local development.
MEDIASOUP_ANNOUNCED_ADDRESS=
MEDIASOUP_RTC_MIN_PORT=40000
MEDIASOUP_RTC_MAX_PORT=49999
MEDIASOUP_ENABLE_UDP=true
MEDIASOUP_ENABLE_TCP=true
MEDIASOUP_PREFER_UDP=true
CALL_RING_TIMEOUT_MS=45000
CALL_RECONNECT_GRACE_MS=15000
RECO_FEATURES_INTERVAL_MS=600000
RECO_EVENT_RETENTION_DAYS=180
REELS_RECOMMENDER_ENABLED=true
REELS_RECOMMENDER_URL=http://localhost:8100
REELS_RECOMMENDER_TOKEN=
REELS_RECOMMENDER_SCHEMA_FINGERPRINT=cd94509ad053c55cb973f5dea69546900e3c6d35fc15e90d7308fdbfb46ab82a
REELS_RECOMMENDER_TIMEOUT_MS=1200
